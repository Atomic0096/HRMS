@page "/reimbursements/edit"
@using Microsoft.EntityFrameworkCore
@using HRMS.Models
@inject IDbContextFactory<HRMS.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager

<PageTitle>Edit</PageTitle>

<h1>Edit</h1>

<h2>Reimbursement</h2>
<hr />
@if (Reimbursement is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-4">
            <EditForm method="post" Model="Reimbursement" OnValidSubmit="UpdateReimbursement" FormName="edit" Enhance>
                <DataAnnotationsValidator />
                <ValidationSummary role="alert"/>
                <input type="hidden" name="Reimbursement.Id" value="@Reimbursement.Id" />
                <div class="mb-3">
                    <label for="date" class="form-label">Date:</label>
                    <InputDate id="date" @bind-Value="Reimbursement.Date" class="form-control" />
                    <ValidationMessage For="() => Reimbursement.Date" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="type" class="form-label">Type:</label>
                    <InputText id="type" @bind-Value="Reimbursement.Type" class="form-control" />
                    <ValidationMessage For="() => Reimbursement.Type" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="amount" class="form-label">Amount:</label>
                    <InputNumber id="amount" @bind-Value="Reimbursement.Amount" class="form-control" />
                    <ValidationMessage For="() => Reimbursement.Amount" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="isapproved" class="form-label">IsApproved:</label>
                    <InputText id="isapproved" @bind-Value="Reimbursement.IsApproved" class="form-control" />
                    <ValidationMessage For="() => Reimbursement.IsApproved" class="text-danger" />
                </div>
                <div class="mb-3">
                    <label for="applicationuserid" class="form-label">ApplicationUserId:</label>
                    <InputText id="applicationuserid" @bind-Value="Reimbursement.ApplicationUserId" class="form-control" />
                    <ValidationMessage For="() => Reimbursement.ApplicationUserId" class="text-danger" />
                </div>
                <button type="submit" class="btn btn-primary">Save</button>
            </EditForm>
        </div>
    </div>
}

<div>
    <a href="/reimbursements">Back to List</a>
</div>

@code {
    [SupplyParameterFromQuery]
    private int Id { get; set; }

    [SupplyParameterFromForm]
    private Reimbursement? Reimbursement { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        Reimbursement ??= await context.Reimbursement.FirstOrDefaultAsync(m => m.Id == Id);

        if (Reimbursement is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    // To protect from overposting attacks, enable the specific properties you want to bind to.
    // For more information, see https://learn.microsoft.com/aspnet/core/blazor/forms/#mitigate-overposting-attacks.
    private async Task UpdateReimbursement()
    {
        using var context = DbFactory.CreateDbContext();
        context.Attach(Reimbursement!).State = EntityState.Modified;

        try
        {
            await context.SaveChangesAsync();
        }
        catch (DbUpdateConcurrencyException)
        {
            if (!ReimbursementExists(Reimbursement!.Id))
            {
                NavigationManager.NavigateTo("notfound");
            }
            else
            {
                throw;
            }
        }

        NavigationManager.NavigateTo("/reimbursements");
    }

    private bool ReimbursementExists(int id)
    {
        using var context = DbFactory.CreateDbContext();
        return context.Reimbursement.Any(e => e.Id == id);
    }
}
