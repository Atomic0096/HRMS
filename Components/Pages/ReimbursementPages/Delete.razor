@page "/reimbursements/delete"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using HRMS.Models
@inject IDbContextFactory<HRMS.Data.ApplicationDbContext> DbFactory
@inject NavigationManager NavigationManager
@attribute [Authorize(Roles = "Admin,Employee")]

<PageTitle>删除报销</PageTitle>

<h1>删除报销</h1>

<div>
    <hr />
    @if (reimbursement is null)
    {
        <p><em>加载中...</em></p>
    }
    else {
        <dl class="row">
            <dt class="col-sm-2">日期</dt>
            <dd class="col-sm-10">@reimbursement.Date</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">类型</dt>
            <dd class="col-sm-10">@reimbursement.Type</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">金额</dt>
            <dd class="col-sm-10">@reimbursement.Amount</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">申请人</dt>
            <dd class="col-sm-10">@reimbursement.ApplicationUser.Name</dd>
        </dl>
        <dl class="row">
            <dt class="col-sm-2">是否批准</dt>
            <dd class="col-sm-10">@reimbursement.IsApproved</dd>
        </dl>
        <EditForm method="post" Model="reimbursement" OnValidSubmit="DeleteReimbursement" FormName="delete" Enhance>
            <button type="submit" class="btn btn-danger" disabled="@(reimbursement is null || reimbursement.IsApproved == "是" || reimbursement.IsApproved == "否")">删除</button>
            <a href="/reimbursements"><button class="btn btn-primary">返回</button></a>
        </EditForm>
    }
</div>

@code {
    private Reimbursement? reimbursement;

    [SupplyParameterFromQuery]
    private int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        using var context = DbFactory.CreateDbContext();
        reimbursement = await context.Reimbursement.Include(m => m.ApplicationUser).FirstOrDefaultAsync(m => m.Id == Id);

        if (reimbursement is null)
        {
            NavigationManager.NavigateTo("notfound");
        }
    }

    private async Task DeleteReimbursement()
    {
        using var context = DbFactory.CreateDbContext();
        context.Reimbursement.Remove(reimbursement!);
        await context.SaveChangesAsync();
        NavigationManager.NavigateTo("/reimbursements");
    }
}
